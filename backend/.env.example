# Chep thanh .env (chay may) hoac khai bao tren Render (Environment)

# Neon PostgreSQL (dung chuoi "pooled")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Chuoi bi mat ky JWT (dai, ngau nhien)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# Broker MQTT - HiveMQ Cloud (TLS cong 8883)
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=smartparking-api
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartparking

# Tai khoan admin tao tu dong khi khoi dong (neu chua co).
# Mat khau that dat trong .env (khong commit) hoac Environment tren Render - KHONG ghi vao file nay
ADMIN_EMAIL=admin@smartparking.vn
ADMIN_PASSWORD=

DEVICE_TIMEOUT_MS=8000
