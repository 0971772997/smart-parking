{
  "name": "smart-parking-api",
  "version": "1.0.0",
  "description": "API bai do xe thong minh (Express + PostgreSQL/Neon + MQTT)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "set-admin": "node scripts/set-admin.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 tests/api.test.js tests/gate.test.js tests/session.test.js tests/payment.test.js tests/push.test.js tests/feedback.test.js tests/admin.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.js",
    "test:security": "node --test --test-concurrency=1 \"tests/unit/security.test.js\" tests/security.test.js",
    "test:load": "node --test --test-concurrency=1 tests/concurrency.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/unit/*.test.js\" \"tests/*.test.js\"",
    "perf": "node scripts/perf.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
